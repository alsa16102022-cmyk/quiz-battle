# Server Configuration
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://quiz_user:secure_password_here@localhost:5432/quiz_battle_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=quiz_user
DB_PASSWORD=secure_password_here
DB_NAME=quiz_battle_db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRY=7d
JWT_REFRESH_SECRET=your_refresh_secret_key

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS Settings
CORS_ORIGIN=http://localhost:19000,http://localhost:8081,http://127.0.0.1:19000

# API Configuration
API_PREFIX=/api

# Email Service (Future)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# AI Question Generator (Future)
OPENAI_API_KEY=sk-your-key-here
